# ─────────────────────────────────────────────────────────────
# Max Fitness Platform — environment variables
# Copy to .env (never commit .env). Every var here is documented in docs/05-engineering/TRD.md §9
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000            # public base URL, e.g. https://maxfitnessgym.in (TBD)
APP_TIMEZONE=Asia/Kolkata
DEMO_MODE=true                           # true = simulated payments + WhatsApp simulator
ALLOW_DEMO_IN_PRODUCTION=false           # boot guard: DEMO_MODE=true with NODE_ENV=production is refused unless this is true
# SHOW_UNCONFIRMED_CONTENT — OPTIONAL, and nothing to do with DEMO_MODE (ADR-085).
#   `true` shows the website's labelled placeholders — unverified facilities, demo
#   reviews. It followed DEMO_MODE until the gym went live and its own members read
#   "DEMO" on the site while standing at reception. Leave it unset in production.
SHOW_UNCONFIRMED_CONTENT=
GYM_SLUG=max-fitness-indirapuram

# Database — Supabase Postgres (Mumbai region), reached ONLY through Prisma.
# Never use supabase-js, the anon key or the service-role key: this app talks to
# Postgres directly and the Supabase Data API is switched off (see security-plan.md §3.6).
#
# DATABASE_URL — Supavisor TRANSACTION pooler, port 6543. Runtime connection used by
#   apps/web through Prisma + @prisma/adapter-pg. Keep the pool small (max 5).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# DIRECT_URL — Supavisor SESSION pooler, port 5432. Needed wherever a session-level
#   connection is required: prisma.config.ts (migrations), the seed script, and the
#   pg-boss worker (pool max 3). Transaction mode cannot serve these.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# SHADOW_DATABASE_URL — OPTIONAL. Only needed if `prisma migrate dev` cannot create a
#   shadow database (the Supabase postgres role lacks CREATEDB). Point it at a SEPARATE,
#   EMPTY Supabase project, session pooler (5432). Leave blank otherwise.
#   Never point this at a database holding real data: Prisma resets it on every migrate.
SHADOW_DATABASE_URL=
#
# TEST_DATABASE_URL — the database the integration tests use, session pooler (5432).
#   **A different database from DATABASE_URL, not a different schema and not the same
#   one.** Until 2026-10-16 both named `postgres`, so `pnpm test` wrote into the live
#   register: a failing test left stray gyms behind, and on the day the gym went live it
#   put forty message-log rows in front of the owner under a member who did not exist.
#   A schema does not isolate anything — Prisma qualifies every table as
#   `"public"."Member"`, so search_path is ignored and the client reads the live rows.
#   Run `pnpm db:migrate:test` to create and migrate `mfp_test` on the same Supabase
#   instance (free, both poolers reach it), then point this at it: the same URL as
#   DATABASE_URL with `/postgres` changed to `/mfp_test`.
#   Unset, the integration suite skips with a clear message instead of failing — which is
#   how a query against a column that did not exist shipped once.
TEST_DATABASE_URL=

# Security
# SEC-008: read by nothing. The CRM session is a 256-bit random token stored as a SHA-256
# hash, so no secret signs the cookie and rotating this invalidates nothing. It is still
# required by the env schema; left in place rather than removed so no deployment breaks,
# but it must not be relied on. Decision for the owner: use it, or drop it from the schema.
SESSION_SECRET=change-me-64-random-chars          # UNUSED — see the note above
LINK_TOKEN_SECRET=change-me-64-random-chars       # signed links: renew, registration, unsubscribe payloads
KIOSK_TOKEN_PEPPER=change-me-32-random-chars      # hashing kiosk device tokens

# SEC-002: how many trusted proxies sit in front of the app.
# `X-Forwarded-For` is a list each hop appends to, so the entries on the left are whatever
# the client sent and the ones on the right were added by our own infrastructure. The
# client address is therefore counted from the right: 1 for Coolify's proxy alone, 2 if a
# CDN sits in front of it. 0 means no proxy (a developer's machine) and the header is then
# not trusted at all. Getting this too low reads a value the client chose, which is how
# every per-IP rate limit gets bypassed.
TRUSTED_PROXY_HOPS=1
FIELD_ENCRYPTION_KEY=base64-32-bytes              # AES-256-GCM for face templates at rest

# Storage (driver: local | s3)
# local = a folder (development). s3 = a PRIVATE Supabase Storage bucket through its
# S3-compatible endpoint (ADR-055). Needed on Vercel, where the local folder is /tmp.
# Supabase dashboard -> Storage -> Settings -> S3 connection: endpoint, region and
# "New access key". These are Storage S3 keys, not the anon or service-role key.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
# the project region, e.g. ap-south-1 (Mumbai)
S3_REGION=
# a private bucket, e.g. member-media (never public)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Razorpay (test keys in dev)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=                     # also the switch for online payment on the public site (ADR-093):
                                         # empty, or DEMO_MODE=true, and /join and /renew reserve the place
                                         # and ask the member to pay at reception instead of taking money
RAZORPAY_WEBHOOK_SECRET=                 # the secret typed into Razorpay when creating the webhook.
                                         # Without it every webhook is rejected, and a member who pays
                                         # and then closes the tab is never confirmed (ADR-103).

# WhatsApp Cloud API (Meta)
WHATSAPP_PROVIDER=simulator             # simulator | meta_cloud | bsp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=                  # system-user permanent token
WHATSAPP_APP_SECRET=                    # verifies X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=                  # webhook GET verification
WHATSAPP_GRAPH_API_VERSION=             # pin the current version at build time
WHATSAPP_ALLOWLIST=+919999999999        # comma-separated; only these receive real sends when DEMO_MODE=true
WHATSAPP_TEMPLATE_LANGUAGES=en          # the languages Meta has APPROVED each template in. A member whose
                                        # record says hi is sent the first listed language instead, because
                                        # asking Meta for an unapproved language loses the message silently.
                                        # Add 'hi' here only once the Hindi templates are approved.
OWNER_WHATSAPP_NUMBER=                  # unused: the digest and alerts go to the OWNER staff record's own number,
                                        # so changing it in Max Register is enough (ADR-065)

# AI — the diet plans and the WhatsApp assistant (ADR-089)
AI_PROVIDER=anthropic                    # anthropic | openai — which service AI_API_KEY belongs to
AI_API_KEY=                             # an Anthropic API key. Empty means no AI: the CRM says the key is
                                        # missing rather than inventing a plan. Never commit a real one.
AI_MODEL=claude-sonnet-5-5              # which model writes the plans

# ── Face attendance (ADR-107) ───────────────────────────────────────────────────
# `apps/face` runs YuNet (MIT) + SFace (Apache 2.0) and turns a photograph into numbers.
# The URL is on the PRIVATE network — this service is given members' faces, and a public
# address would make it a face search engine for anybody who found it.
# Empty means no face recognition: the check-in screen falls back to the keypad and says so.
FACE_SERVICE_URL=                       # e.g. http://face:8000 inside the project network
FACE_SERVICE_TOKEN=                     # any long random string; must match the service's own

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Security headers (SEC-001; apps/web/src/lib/security-headers.ts)
# Leave empty to ENFORCE the Content-Security-Policy. Set to `true` to send it as
# Content-Security-Policy-Report-Only instead, which is how to watch a policy change on
# the live site before letting it break a screen. Every other security header is always
# enforced and is not affected by this.
CSP_REPORT_ONLY=

# Analytics (optional, consent-gated)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Web
# WEB_DB_POOL_MAX — connections one web container holds on the transaction pooler (:6543).
#   Sized for the widest screen's fan-out, not one query per request: the CRM home screen
#   issues about twenty reads at once, and a smaller pool makes them queue in serial waves.
#   The pooler multiplexes these onto far fewer backend connections, so this is not the
#   gym's connection budget. Raise it only alongside the container count.
WEB_DB_POOL_MAX=16

# Worker
WORKER_CONCURRENCY=4
WORKER_ID=worker-main                     # WorkerHeartbeat row id; must be unique per worker instance
WORKER_DB_POOL_MAX=3                      # pg-boss uses DIRECT_URL (session pooler); keep this small

# Seed & demo
SEED_TODAY=                               # optional YYYY-MM-DD (IST) for reproducible demo data; blank = today
