# syntax=docker/dockerfile:1

# The background worker: reminders, the outbox, diet follow-ups, nightly jobs
# (deployment-plan.md §1; system-architecture.md §5).
#
# **Exactly one instance.** The schedules are cron-like and the outbox is polled; two
# copies would evaluate the same slot twice. The idempotency keys would stop a member
# being messaged twice, but the right number of replicas is still one.
#
# It has no inbound port, so there is nothing to HTTP-healthcheck. The evidence that it is
# alive is the heartbeat row it keeps touching, which `/api/v1/health` reads — one URL
# covering both processes, as ADR-018 intended.
#
# One stage, on purpose. The worker runs its TypeScript through `tsx` rather than compiling
# it, which is how it reads the same source the tests and the app read — so the development
# dependencies have to survive into the running image anyway, and a second stage would copy
# everything across to save nothing.

FROM node:24-alpine
WORKDIR /app

# NODE_ENV is pinned to development for the install and only flipped at the end.
#
# Coolify passes every environment variable into the build, so `NODE_ENV=production` arrives
# as a build argument — and a production install skips devDependencies, which would leave
# this image without `tsx` and unable to start. Setting it here beats whatever is injected.
ENV NODE_ENV=development

RUN corepack enable

# Manifests first, so a change to application code does not reinstall the world.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/worker/package.json apps/worker/
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/integrations/package.json packages/integrations/

# `...<pkg>` is "that package and everything it depends on". The other order, `<pkg>...`,
# selects its dependents, which is the opposite direction. apps/web falls outside it on
# purpose: the worker never imports it, and installing it would pull Next in for nothing.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --filter ...@mfp/worker

COPY tsconfig.base.json ./
COPY apps/worker ./apps/worker
COPY packages ./packages

# Generated TypeScript, read directly by `tsx` at runtime. No database is contacted.
RUN pnpm --filter @mfp/db run db:generate

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker && \
    chown -R worker:nodejs /app
USER worker

ENV NODE_ENV=production

# Run from the worker's own directory so its relative paths — the root .env it loads when
# one exists — resolve the way they do in development.
WORKDIR /app/apps/worker
CMD ["pnpm", "run", "start"]
