{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", ".env"],
  "globalEnv": [
    "NODE_ENV",
    "APP_URL",
    "APP_TIMEZONE",
    "DEMO_MODE",
    "ALLOW_DEMO_IN_PRODUCTION",
    "GYM_SLUG",
    "DATABASE_URL",
    "DIRECT_URL",
    "SHADOW_DATABASE_URL",
    "TEST_DATABASE_URL",
    "SESSION_SECRET",
    "LINK_TOKEN_SECRET",
    "KIOSK_TOKEN_PEPPER",
    "FIELD_ENCRYPTION_KEY",
    "STORAGE_DRIVER",
    "STORAGE_LOCAL_PATH",
    "WHATSAPP_PROVIDER",
    "WHATSAPP_ALLOWLIST",
    "OWNER_WHATSAPP_NUMBER",
    "LOG_LEVEL",
    "WORKER_ID",
    "WORKER_CONCURRENCY",
    "WORKER_DB_POOL_MAX",
    "SEED_TODAY"
  ],
  "tasks": {
    "db:generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    }
  }
}
