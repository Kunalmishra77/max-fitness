// ─────────────────────────────────────────────────────────────────────────────
// Max Fitness Platform — Prisma schema (v1.0 blueprint)
// Copy to packages/db/prisma/schema.prisma in Phase 1.
// Conventions: money = Int paise; business dates = @db.Date (IST);
// timestamps = DateTime @db.Timestamptz (UTC). Every tenant row has gymId.
// ─────────────────────────────────────────────────────────────────────────────

// Prisma 7+: connection URL lives in packages/db/prisma.config.ts and the
// PrismaClient is constructed with the @prisma/adapter-pg driver adapter.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum StaffRole {
  OWNER
  RECEPTION
  TRAINER
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MemberStatus {
  PENDING_PAYMENT
  PENDING_VERIFICATION
  ACTIVE
  LEFT
  BLOCKED
}

enum MemberSource {
  WEBSITE
  QR_NEW
  QR_EXISTING
  WALK_IN
  IMPORT
  CRM
}

enum LeftReason {
  WHATSAPP_UNSUBSCRIBE
  OWNER_MARKED
  LAPSED
  MOVED_AWAY
  PRICE
  HEALTH
  NOT_SATISFIED
  OTHER
}

enum Language {
  hi
  en
}

enum MembershipStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum PlanKind {
  MEMBERSHIP
  PT
}

/// ADR-089. COLLECTING while the member is still answering; SUPERSEDED once a newer plan exists.
enum DietPlanStatus {
  COLLECTING
  GENERATING
  READY
  FAILED
  SUPERSEDED
}

enum PtEnrolmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  CASH
  UPI_DIRECT
  CARD_POS
  BANK_TRANSFER
  SIMULATED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  VOIDED
  REFUNDED
}

/// The life of a standing instruction, in Razorpay's own words (ADR-105).
///
/// `CREATED` is a subscription that exists but which the member has not authorised yet —
/// the link has been made and may never be opened. `ACTIVE` is the only status that means
/// money will arrive without anyone asking. `HALTED` is the dangerous one: Razorpay gave
/// up after repeated failures, and a halted mandate looks exactly like a paid-up member
/// until somebody checks, which is why it raises an alert rather than sitting quietly.
enum MandateStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  PAUSED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL_BOOKED
  VISITED
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE_HERO
  WEBSITE_OTHER
  WHATSAPP
  WALK_IN
  PHONE
  INSTAGRAM
  GBP
  REFERRAL
  ABANDONED_SIGNUP
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsentType {
  TERMS
  PRIVACY
  WHATSAPP_UPDATES
  FACE_ATTENDANCE
  PARENTAL
  PHOTO_MARKETING
}

enum MediaKind {
  SELFIE
  ENROLLMENT_FRAME
  RECEIPT_PDF
  CHECKIN_SNAPSHOT
  IMPORT_FILE
  /// A photograph of a government ID. The number is never stored (ADR-074).
  GOV_ID
}

enum FaceTemplateStatus {
  ACTIVE
  REVOKED
}

enum EnrollmentJobStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

enum AttendanceMethod {
  FACE
  FACE_CONFIRMED
  KEYPAD
  MANUAL
}

enum KioskStatus {
  ACTIVE
  REVOKED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
  SIMULATED
}

enum MessagePurpose {
  REMINDER
  RECEIPT
  WELCOME
  VERIFICATION
  OTP
  OWNER_DIGEST
  OWNER_ALERT
  BIRTHDAY
  ANNOUNCEMENT
  UNSUBSCRIBE_CONFIRM
  RESTART_CONFIRM
  /// The diet questionnaire and the plan it produces (ADR-089).
  DIET
  /// What the WhatsApp assistant answered a member by itself (ADR-090).
  BOT
  OTHER
}

enum CallTaskReason {
  EXPIRED_BUT_VISITING
  SIGNUP_NOT_PAID
  NEW_LEAD
  VERIFICATION_PENDING
  EXPIRED_NOT_RENEWED
  DUE_SOON_NO_RESPONSE
  ABSENT_7_DAYS
  UNSUBSCRIBED
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
  AUTO_CLOSED
}

enum CallOutcome {
  WILL_RENEW
  CALL_LATER
  NO_ANSWER
  LEFT_GYM
  WRONG_NUMBER
  DONE
}

enum AlertType {
  EXPIRED_MEMBER_VISIT
  ONLINE_PAYMENT
  NEW_LEAD
  VERIFICATION_PENDING
  MEMBER_UNSUBSCRIBED
  KIOSK_OFFLINE
  WHATSAPP_FAILURE
  WHATSAPP_QUALITY
  SYSTEM
}

enum OtpPurpose {
  SIGNUP
  QR_EXISTING
  CRM_LOGIN_RESET
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

// ───────────────────────────── Tenant & settings ─────────────────────────────

model Gym {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  phone       String
  /// The gym's own address for correspondence. Shown on the website's contact page and
  /// footer because a business verification (Meta, Razorpay) compares what is published
  /// against what is on the registration certificate, and a missing one is a discrepancy.
  email       String?
  addressLine String
  city        String
  state       String
  pincode     String
  latitude    Float?
  longitude   Float?
  /// Zod-validated JSON: hours, reminder slots, caps, feature flags, trust numbers, promo, etc.
  settings    Json
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  staff         StaffUser[]
  plans         Plan[]
  members       Member[]
  memberships   Membership[]
  ptEnrolments  PtEnrolment[]
  dietProfiles  DietProfile[]
  dietPlans     DietPlan[]
  dietFollowUps DietFollowUp[]
  botConfig     BotConfig?
  botDocuments  BotDocument[]
  botReplies    BotReply[]
  galleryPhotos GalleryPhoto[]
  payments      Payment[]
  mandates      Mandate[]
  leads         Lead[]
  verifications VerificationRequest[]
  media         MediaFile[]
  faceTemplates FaceTemplate[]
  enrollJobs    EnrollmentJob[]
  attendance    AttendanceEvent[]
  kiosks        KioskDevice[]
  reminderRules ReminderRule[]
  messages      MessageLog[]
  callTasks     CallTask[]
  alerts        Alert[]
  consents      Consent[]
  auditLogs     AuditLog[]
  counters      Counter[]
  outbox        OutboxEvent[]
  otps          OtpCode[]
  webhookEvents WebhookEvent[]
  announcements Announcement[]
}

/// One message the owner sent to every member at once (ADR-079). The row is the source
/// of the words: the outbox events carry only its id, so nothing can drift.
model Announcement {
  id             String   @id @default(cuid())
  gymId          String
  textEn         String
  textHi         String
  /// "ACTIVE" (members with a running plan) or "EVERYONE" on the register.
  audience       String
  createdById    String
  /// How many members it was queued for, after the ones who cannot be messaged.
  recipientCount Int
  sentAt         DateTime @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz

  gym       Gym       @relation(fields: [gymId], references: [id])
  createdBy StaffUser @relation(fields: [createdById], references: [id])

  @@index([gymId, sentAt])
}

model Counter {
  id    String @id @default(cuid())
  gymId String
  /// e.g. "member_code", "receipt:2026-27"
  key   String
  value Int    @default(0)
  gym   Gym    @relation(fields: [gymId], references: [id])

  @@unique([gymId, key])
}

// ───────────────────────────── Staff & auth ─────────────────────────────

model StaffUser {
  id             String    @id @default(cuid())
  gymId          String
  name           String
  mobile         String
  /// Sign-in by address as well as by number (ADR-094); optional, because the desk's
  /// own staff are known by their phone and should not be made to invent an email.
  email          String?
  role           StaffRole
  pinHash        String
  language       Language  @default(hi)
  voiceEnabled   Boolean   @default(true)
  isActive       Boolean   @default(true)
  failedPinCount Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz
  lastLoginAt    DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  gym           Gym            @relation(fields: [gymId], references: [id])
  sessions      Session[]
  announcements Announcement[]

  @@unique([gymId, mobile])
  @@unique([gymId, email])
}

model Session {
  id          String    @id @default(cuid())
  staffUserId String
  /// sha256 of the random session token; raw token only in cookie
  tokenHash   String    @unique
  userAgent   String?
  ipHash      String?
  trusted     Boolean   @default(false)
  expiresAt   DateTime  @db.Timestamptz
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
}

model OtpCode {
  id         String     @id @default(cuid())
  gymId      String
  mobile     String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime   @db.Timestamptz
  consumedAt DateTime?  @db.Timestamptz
  createdAt  DateTime   @default(now()) @db.Timestamptz

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, mobile, purpose])
}

// ───────────────────────────── Plans ─────────────────────────────

model Plan {
  id             String   @id @default(cuid())
  gymId          String
  code           String // e.g. "M1_MALE", "M12_FEMALE", "PT3_MALE"
  /// MEMBERSHIP or PT. PT is sold alongside a membership, never instead of one (ADR-087).
  kind           PlanKind @default(MEMBERSHIP)
  durationMonths Int
  gender         Gender
  /// The total for the whole term, in paise. A per-month figure is derived for display.
  pricePaise     Int
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  /// Razorpay's plan id, set by `create:razorpay-plans` for the monthly rows and left null
  /// for the rest, because autopay is monthly-only (ADR-105). A Razorpay plan is immutable,
  /// so changing `pricePaise` here means creating a new one and pointing this at it; the
  /// mandates already running keep charging the old amount until they are cancelled.
  providerPlanId String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  gym           Gym            @relation(fields: [gymId], references: [id])
  memberships   Membership[]
  ptEnrolments  PtEnrolment[]
  mandates      Mandate[]

  @@unique([gymId, code])
  @@index([gymId, kind, gender, isActive])
}

/// A photo the gym put on its own website (ADR-091).
///
/// The landing page shipped with the gym's Google Business Profile uploads built in. These
/// are the owner's own, uploaded from Max Register, and they replace the built-in set as
/// soon as there is one published — so the site is never half one and half the other.
model GalleryPhoto {
  id          String   @id @default(cuid())
  gymId       String
  storageKey  String
  /// Shown under the photo and used as its alt text, in both languages.
  captionEn   String?
  captionHi   String?
  /// Natural size, measured in the browser before upload, so the page reserves the space.
  width       Int
  height      Int
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  uploadedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, isPublished, sortOrder])
}

/// The WhatsApp assistant's settings — one row per gym (ADR-090).
///
/// Off until the owner turns it on, and `autoReply` is a second switch: a gym may want the
/// bot configured and tested without it answering anybody yet.
model BotConfig {
  id             String   @id @default(cuid())
  gymId          String   @unique
  name           String   @default("Max")
  isActive       Boolean  @default(false)
  /// Whether it answers members by itself. Off means it only answers in the test chat.
  autoReply      Boolean  @default(false)
  /// The owner's persona prompt: how it should sound.
  persona        String   @default("")
  /// Which languages the gym serves; the reply follows the member's own language.
  languages      String[] @default(["hi", "en"])
  /// What the member is told when it cannot answer — a number, a name, "come to the desk".
  escalationNote String?
  updatedById    String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  gym Gym @relation(fields: [gymId], references: [id])
}

/// One thing the gym has written down for the assistant to answer from (ADR-090).
///
/// Text, not a file: whatever the owner uploads is turned into text before it is saved, so
/// the prompt never contains a binary and the owner can read and correct what the bot knows.
model BotDocument {
  id          String   @id @default(cuid())
  gymId       String
  title       String
  body        String
  /// The file it came from, when it came from one.
  sourceName  String?
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, createdAt])
}

enum BotReplyStatus {
  ANSWERED
  ESCALATED
  FAILED
}

/// Every question the assistant was asked and what it did (ADR-090).
///
/// The log is the whole point of the feature for the owner: it is where they see what members
/// actually ask, which is how the knowledge base gets better.
model BotReply {
  id        String         @id @default(cuid())
  gymId     String
  memberId  String?
  /// Masked in the UI; stored because a question can arrive from a number we do not know.
  mobile    String
  question  String
  answer    String?
  status    BotReplyStatus
  /// Why it failed or escalated, as a code.
  reason    String?
  /// True when it came from the owner's test chat rather than from a member.
  isTest    Boolean        @default(false)
  createdAt DateTime       @default(now()) @db.Timestamptz

  gym    Gym     @relation(fields: [gymId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])

  @@index([gymId, createdAt])
  @@index([gymId, status])
}

/// What a member has told us about their body, their goal and their food (ADR-089).
///
/// One row per member, updated as they answer and reused for every later plan, so nobody
/// is asked their height twice. `pendingQuestion` is what we are waiting on right now —
/// it is also how an inbound message is recognised as an answer rather than a question.
model DietProfile {
  id              String    @id @default(cuid())
  gymId           String
  memberId        String    @unique
  weightGrams     Int?
  heightCm        Int?
  ageYears        Int?
  goal            String?
  dietType        String?
  allergies       String?
  mealsPerDay     Int?
  activityLevel   String?
  workoutsPerWeek Int?
  /// The question the member is being asked, or null when we are not waiting on them.
  pendingQuestion String?
  /// How many times we have asked without an answer, so the nudges stop (ADR-089).
  nudgesSent      Int       @default(0)
  askedAt         DateTime? @db.Timestamptz
  lastReplyAt     DateTime? @db.Timestamptz
  completedAt     DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([gymId, pendingQuestion])
}

/// One generated diet plan (ADR-089). The answers are copied in, so editing the profile
/// later never rewrites a plan the member already has.
model DietPlan {
  id            String         @id @default(cuid())
  gymId         String
  memberId      String
  version       Int
  status        DietPlanStatus
  /// The answers as they stood when this was written.
  answers       Json
  /// BMI × 10, an integer for the same reason money is paise.
  bmiTenths     Int?
  /// The plan itself, in the shape `DietPlanDocSchema` describes. Null until it is written.
  doc           Json?
  /// Which model wrote it, so a bad batch can be traced to one.
  model         String?
  /// Why it could not be sent: a parse failure, or a safety check it did not pass.
  failureReason String?
  pdfMediaId    String?
  requestedById String?
  generatedAt   DateTime?      @db.Timestamptz
  sentAt        DateTime?      @db.Timestamptz
  createdAt     DateTime       @default(now()) @db.Timestamptz
  updatedAt     DateTime       @updatedAt @db.Timestamptz

  gym       Gym             @relation(fields: [gymId], references: [id])
  member    Member          @relation(fields: [memberId], references: [id])
  followUps DietFollowUp[]

  @@unique([memberId, version])
  @@index([gymId, status, createdAt])
}

/// A monthly check on how the plan is going (ADR-089). The answers steer the next plan.
model DietFollowUp {
  id              String    @id @default(cuid())
  gymId           String
  memberId        String
  dietPlanId      String
  /// Which question is outstanding, same idea as on the profile.
  pendingQuestion String?
  /// Keyed answers as they come in.
  answers         Json
  askedAt         DateTime  @default(now()) @db.Timestamptz
  completedAt     DateTime? @db.Timestamptz

  gym      Gym      @relation(fields: [gymId], references: [id])
  member   Member   @relation(fields: [memberId], references: [id])
  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id])

  @@index([gymId, completedAt])
  @@index([memberId])
}

/// Personal training bought by a member, alongside the membership it rides on (ADR-087).
model PtEnrolment {
  id             String            @id @default(cuid())
  gymId          String
  memberId       String
  planId         String
  /// The membership this PT term goes with, when it was bought together with one.
  membershipId   String?
  durationMonths Int
  startDate      DateTime          @db.Date
  endDate        DateTime          @db.Date
  /// Copied from the plan at purchase: a price change must never alter what was paid (BR-2.8).
  pricePaise     Int
  status         PtEnrolmentStatus
  createdById    String?
  confirmedAt    DateTime?         @db.Timestamptz
  cancelledAt    DateTime?         @db.Timestamptz
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  gym        Gym         @relation(fields: [gymId], references: [id])
  member     Member      @relation(fields: [memberId], references: [id])
  plan       Plan        @relation(fields: [planId], references: [id])
  membership Membership? @relation(fields: [membershipId], references: [id])
  payments   Payment[]

  @@index([gymId, status, endDate])
  @@index([memberId])
}

// ───────────────────────────── Members ─────────────────────────────

model Member {
  id                      String       @id @default(cuid())
  gymId                   String
  memberCode              String? // "MF-0231", assigned on first confirmation
  fullName                String
  /// E.164, NOT unique: families share numbers
  mobile                  String
  email                   String? // stored lowercased + trimmed
  dob                     DateTime?    @db.Date
  gender                  Gender
  language                Language     @default(hi)
  status                  MemberStatus
  source                  MemberSource
  isMinor                 Boolean      @default(false)
  photoMediaId            String?      @unique
  whatsappOptIn           Boolean      @default(false)
  faceConsent             Boolean      @default(false)
  remindersUnsubscribedAt DateTime?    @db.Timestamptz
  remindersPausedUntil    DateTime?    @db.Date
  /// When they first joined the gym, which may be long before this system existed.
  /// Optional: plenty of members will not remember (ADR-074).
  joinedOn                DateTime?    @db.Date
  /// Which half of the day they train in — the gym shuts between noon and five, so
  /// "MORNING", "EVENING" or "BOTH" is what tells the owner how to staff it (ADR-082).
  trainingSlot            String?
  leftAt                  DateTime?    @db.Date
  leftReason              LeftReason?
  leftNote                String?
  notes                   String?
  lastAttendanceAt        DateTime?    @db.Timestamptz
  createdById             String? // staff user id when created at desk
  createdAt               DateTime     @default(now()) @db.Timestamptz
  updatedAt               DateTime     @updatedAt @db.Timestamptz
  deletedAt               DateTime?    @db.Timestamptz

  gym           Gym                   @relation(fields: [gymId], references: [id])
  photo         MediaFile?            @relation("MemberPhoto", fields: [photoMediaId], references: [id])
  memberships   Membership[]
  ptEnrolments  PtEnrolment[]
  dietProfile   DietProfile?
  dietPlans     DietPlan[]
  dietFollowUps DietFollowUp[]
  botReplies    BotReply[]
  payments      Payment[]
  media         MediaFile[]           @relation("MemberMedia")
  faceTemplates FaceTemplate[]
  enrollJobs    EnrollmentJob[]
  attendance    AttendanceEvent[]
  messages      MessageLog[]
  callTasks     CallTask[]
  consents      Consent[]
  verifications VerificationRequest[]
  alerts        Alert[]
  mandates      Mandate[]

  @@unique([gymId, memberCode])
  @@index([gymId, status])
  @@index([gymId, mobile])
  @@index([gymId, fullName])
}

model Membership {
  id              String           @id @default(cuid())
  gymId           String
  memberId        String
  planId          String?
  durationMonths  Int?
  startDate       DateTime?        @db.Date
  endDate         DateTime         @db.Date
  pricePaise      Int              @default(0)
  discountPaise   Int              @default(0)
  discountReason  String?
  admissionPaise  Int              @default(0)
  status          MembershipStatus
  source          MemberSource
  /// true when created from QR/import declaration rather than a payment in this system
  isDeclared      Boolean          @default(false)
  /// A paid trial bought by a newcomer, priced per day rather than from a plan (ADR-088).
  isTrial         Boolean          @default(false)
  trialDays       Int?
  declaredEndDate DateTime?        @db.Date
  createdById     String?
  confirmedAt     DateTime?        @db.Timestamptz
  cancelledAt     DateTime?        @db.Timestamptz
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  gym          Gym           @relation(fields: [gymId], references: [id])
  member       Member        @relation(fields: [memberId], references: [id])
  plan         Plan?         @relation(fields: [planId], references: [id])
  payments     Payment[]
  messages     MessageLog[]
  ptEnrolments PtEnrolment[]

  @@index([gymId, status, endDate])
  @@index([memberId, endDate])
}

model Payment {
  id                  String        @id @default(cuid())
  gymId               String
  memberId            String
  membershipId        String?
  /// Set when this payment also covers personal training (ADR-087). The split is read
  /// from the membership and the enrolment, so no amount is stored twice.
  ptEnrolmentId       String?
  amountPaise         Int
  method              PaymentMethod
  status              PaymentStatus
  receiptNo           String?
  providerOrderId     String?       @unique
  providerPaymentId   String?       @unique
  providerSignatureOk Boolean       @default(false)
  /// Set when this payment arrived by itself, debited against a standing instruction
  /// rather than taken at the counter or through a checkout (ADR-105). Everything else
  /// about the row is identical, so receipts, the day book and the fee state need no
  /// knowledge of mandates at all.
  mandateId           String?
  failureReason       String?
  paidAt              DateTime?     @db.Timestamptz
  recordedById        String?
  voidedById          String?
  voidReason          String?
  receiptMediaId      String?
  createdAt           DateTime      @default(now()) @db.Timestamptz
  updatedAt           DateTime      @updatedAt @db.Timestamptz

  gym         Gym          @relation(fields: [gymId], references: [id])
  member      Member       @relation(fields: [memberId], references: [id])
  membership  Membership?  @relation(fields: [membershipId], references: [id])
  ptEnrolment PtEnrolment? @relation(fields: [ptEnrolmentId], references: [id])
  mandate     Mandate?     @relation(fields: [mandateId], references: [id])

  @@unique([gymId, receiptNo])
  @@index([gymId, status, paidAt])
  @@index([memberId])
  @@index([mandateId])
}

/// A standing instruction the member gave their UPI app or bank, so the fee arrives on its
/// own and the gym stops chasing it every month (ADR-105).
///
/// Monthly only, on purpose. The 3, 6 and 12-month plans are prepaid lump sums; letting a
/// member sign one standing instruction for a year is a different product than the one the
/// gym sells, so `intervalMonths` is always 1 and the constraint is in the domain, not here,
/// where a later product decision can relax it without a migration.
///
/// A mandate never gates anything. Entry, attendance and the membership itself are decided
/// without consulting this table — cancel a mandate and the member simply pays at the
/// counter again, exactly as they did before.
model Mandate {
  id       String @id @default(cuid())
  gymId    String
  memberId String
  /// Which of the gym's own plans this charges for. The amount is copied from it at
  /// creation and then frozen, because Razorpay's plan is immutable and the two must agree
  /// for the life of the mandate even if the gym later changes its price list.
  planId   String

  /// Razorpay's subscription, which is the mandate. Unique because one Razorpay
  /// subscription is one row here, and a re-delivered webhook must find the same row.
  providerSubscriptionId String  @unique
  /// Razorpay's plan, copied from `Plan.providerPlanId` at creation so the history survives
  /// the gym deactivating that plan.
  providerPlanId         String
  /// Razorpay's customer record, reused if this member ever sets up a second mandate.
  providerCustomerId     String?

  status         MandateStatus @default(CREATED)
  /// What each debit takes, in paise, frozen at creation (BR-2.2; CLAUDE.md §2.1).
  amountPaise    Int
  intervalMonths Int           @default(1)

  /// The authorisation link Razorpay issues. Razorpay expires it, so a member who never
  /// opened it needs a fresh mandate rather than a resend of this one.
  shortUrl       String?
  authorisedAt   DateTime?     @db.Timestamptz
  /// Razorpay's own next-charge date, as an Asia/Kolkata business date (CLAUDE.md §2.2).
  /// Advisory only: what actually extends a membership is a `subscription.charged` event,
  /// never this field arriving in the past.
  nextChargeOn   DateTime?     @db.Date
  /// How many debits Razorpay has told us about. Used to notice a mandate that authorised
  /// but has never charged.
  chargeCount    Int           @default(0)
  lastChargedAt  DateTime?     @db.Timestamptz
  /// Why Razorpay halted or the member's bank refused, as given. Never a card number or a
  /// VPA: the masking helpers apply here as everywhere (CLAUDE.md §2.8).
  failureReason  String?
  haltedAt       DateTime?     @db.Timestamptz
  cancelledAt    DateTime?     @db.Timestamptz
  /// Who cancelled it. Null when Razorpay or the member's bank ended it, set when somebody
  /// at the desk did.
  cancelledById  String?
  cancelReason   String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  gym      Gym       @relation(fields: [gymId], references: [id])
  member   Member    @relation(fields: [memberId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  /// One live mandate per member is enforced in the domain, not here: a member may hold a
  /// cancelled one and a new one at the same time, and a partial unique index is not
  /// something Prisma expresses. This index is what that check reads.
  @@index([gymId, status])
  @@index([memberId, status])
}

// ───────────────────────────── Leads & verification ─────────────────────────────

model Lead {
  id                String     @id @default(cuid())
  gymId             String
  name              String
  mobile            String
  goal              String?
  source            LeadSource
  status            LeadStatus @default(NEW)
  utm               Json?
  notes             String?
  followUpAt        DateTime?  @db.Timestamptz
  convertedMemberId String?
  consentContact    Boolean    @default(true)
  createdAt         DateTime   @default(now()) @db.Timestamptz
  updatedAt         DateTime   @updatedAt @db.Timestamptz

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, status, createdAt])
  @@index([gymId, mobile])
}

model VerificationRequest {
  id                    String             @id @default(cuid())
  gymId                 String
  memberId              String
  referenceCode         String // shown to member at reception, e.g. "Q-4821"
  declaredPlanMonths    Int?
  declaredEndDate       DateTime           @db.Date
  declaredAmountPaise   Int?
  /// Which card the photographs are of. The number itself is never stored (ADR-074).
  govIdType             String?
  matchedImportMemberId String?
  status                VerificationStatus @default(PENDING)
  decidedById           String?
  decidedAt             DateTime?          @db.Timestamptz
  approvedEndDate       DateTime?          @db.Date
  rejectReason          String?
  createdAt             DateTime           @default(now()) @db.Timestamptz

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([gymId, referenceCode])
  @@index([gymId, status, createdAt])
}

// ───────────────────────────── Media & consent ─────────────────────────────

model MediaFile {
  id          String    @id @default(cuid())
  gymId       String
  memberId    String?
  kind        MediaKind
  /// Which one, when a member has several of a kind: "aadhaar-front", "aadhaar-back", "pan-front"
  label       String?
  storageKey  String    @unique
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  sha256      String
  deleteAfter DateTime? @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  gym     Gym     @relation(fields: [gymId], references: [id])
  member  Member? @relation("MemberMedia", fields: [memberId], references: [id])
  photoOf Member? @relation("MemberPhoto")

  @@index([gymId, kind])
  @@index([memberId])
}

model Consent {
  id            String      @id @default(cuid())
  gymId         String
  memberId      String
  type          ConsentType
  granted       Boolean
  noticeVersion String
  channel       String // "web_signup" | "qr" | "crm_desk" | "kiosk" | "whatsapp"
  ipHash        String?
  userAgent     String?
  recordedById  String? // staff for desk/parental consent
  guardianName  String?
  createdAt     DateTime    @default(now()) @db.Timestamptz
  withdrawnAt   DateTime?   @db.Timestamptz

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, type])
}

// ───────────────────────────── Face & attendance ─────────────────────────────

model FaceTemplate {
  id              String             @id @default(cuid())
  gymId           String
  memberId        String
  /// AES-256-GCM encrypted Float32 little-endian vector
  vectorEnc       Bytes
  dimensions      Int
  modelVersion    String
  qualityScore    Float
  sourceMediaId   String?
  sourceKind      String // "signup_selfie" | "assisted" | "adaptive"
  createdByDevice String?
  status          FaceTemplateStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @db.Timestamptz
  revokedAt       DateTime?          @db.Timestamptz

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([gymId, status, modelVersion])
  @@index([memberId])
}

model EnrollmentJob {
  id           String              @id @default(cuid())
  gymId        String
  memberId     String
  mediaId      String
  modelVersion String
  status       EnrollmentJobStatus @default(PENDING)
  claimedBy    String? // kiosk device id
  attempts     Int                 @default(0)
  error        String?
  createdAt    DateTime            @default(now()) @db.Timestamptz
  updatedAt    DateTime            @updatedAt @db.Timestamptz

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([gymId, status])
}

model KioskDevice {
  id              String      @id @default(cuid())
  gymId           String
  name            String
  tokenHash       String?     @unique
  pairingCodeHash String?
  pairingExpires  DateTime?   @db.Timestamptz
  status          KioskStatus @default(ACTIVE)
  appVersion      String?
  modelVersion    String?
  lastSeenAt      DateTime?   @db.Timestamptz
  lastHeartbeat   Json? // battery, temperatureC, queueSize, cameraOk, freeStorageMb
  shadowMode      Boolean     @default(true)
  createdAt       DateTime    @default(now()) @db.Timestamptz
  revokedAt       DateTime?   @db.Timestamptz

  gym        Gym               @relation(fields: [gymId], references: [id])
  attendance AttendanceEvent[]
}

model AttendanceEvent {
  id                String           @id @default(cuid())
  gymId             String
  memberId          String
  kioskDeviceId     String?
  clientEventId     String           @unique
  method            AttendanceMethod
  capturedAt        DateTime         @db.Timestamptz
  attendanceDate    DateTime         @db.Date
  matchScore        Float?
  livenessScore     Float?
  modelVersion      String?
  feeStateAtCheckIn String? // PAID | DUE_SOON | EXPIRED | NONE
  snapshotMediaId   String?
  recordedById      String?
  voidedAt          DateTime?        @db.Timestamptz
  createdAt         DateTime         @default(now()) @db.Timestamptz

  gym         Gym          @relation(fields: [gymId], references: [id])
  member      Member       @relation(fields: [memberId], references: [id])
  kioskDevice KioskDevice? @relation(fields: [kioskDeviceId], references: [id])

  @@index([gymId, attendanceDate])
  @@index([memberId, capturedAt])
}

// ───────────────────────────── Messaging ─────────────────────────────

model ReminderRule {
  id           String   @id @default(cuid())
  gymId        String
  code         String // PRE_7 | PRE_3 | PRE_2 | PRE_1 | DUE_TODAY | POST | TRIAL_*
  /// MEMBERSHIP or TRIAL: a three-day trial must never be told to renew (ADR-088).
  appliesTo    String   @default("MEMBERSHIP")
  /// days relative to endDate; for POST this is the first day (+1)
  offsetDays   Int
  /// for POST: last offset (null = no limit); otherwise equals offsetDays
  offsetDaysTo Int?
  /// "HH:mm" IST
  slots        String[]
  templateName String
  isEnabled    Boolean  @default(true)
  updatedAt    DateTime @updatedAt @db.Timestamptz

  gym Gym @relation(fields: [gymId], references: [id])

  @@unique([gymId, code])
}

model MessageLog {
  id                String           @id @default(cuid())
  gymId             String
  memberId          String?
  membershipId      String?
  direction         MessageDirection
  purpose           MessagePurpose
  ruleCode          String?
  templateName      String?
  language          Language?
  toNumber          String? // E.164; masked in UI
  fromNumber        String?
  idempotencyKey    String?          @unique
  providerMessageId String?          @unique
  status            MessageStatus
  /// The IST day this message belongs to; the per-number daily cap counts by it (BR-5.6)
  businessDate      DateTime?        @db.Date
  bodyPreview       String? // rendered text for log/simulator (no secrets)
  payload           Json? // variables / inbound content
  errorCode         String?
  errorMessage      String?
  scheduledFor      DateTime?        @db.Timestamptz
  sentAt            DateTime?        @db.Timestamptz
  deliveredAt       DateTime?        @db.Timestamptz
  readAt            DateTime?        @db.Timestamptz
  createdAt         DateTime         @default(now()) @db.Timestamptz

  gym        Gym         @relation(fields: [gymId], references: [id])
  member     Member?     @relation(fields: [memberId], references: [id])
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@index([gymId, createdAt])
  @@index([memberId, createdAt])
  @@index([gymId, status])
  @@index([toNumber, businessDate])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  gymId       String?
  provider    String // "razorpay" | "whatsapp"
  externalId  String // event id / message id + status
  eventType   String
  signatureOk Boolean
  payload     Json
  processedAt DateTime? @db.Timestamptz
  error       String?
  receivedAt  DateTime  @default(now()) @db.Timestamptz

  gym Gym? @relation(fields: [gymId], references: [id])

  @@unique([provider, externalId])
  @@index([provider, processedAt])
}

// ───────────────────────────── Tasks, alerts, audit ─────────────────────────────

model CallTask {
  id           String         @id @default(cuid())
  gymId        String
  memberId     String?
  leadId       String?
  reason       CallTaskReason
  priority     Int
  status       TaskStatus     @default(OPEN)
  dueDate      DateTime       @db.Date
  snoozedUntil DateTime?      @db.Date
  attempts     Int            @default(0)
  outcome      CallOutcome?
  note         String?
  doneById     String?
  doneAt       DateTime?      @db.Timestamptz
  createdAt    DateTime       @default(now()) @db.Timestamptz
  updatedAt    DateTime       @updatedAt @db.Timestamptz

  gym    Gym     @relation(fields: [gymId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])

  @@index([gymId, status, dueDate, priority])
  @@index([memberId, reason, status])
}

model Alert {
  id         String    @id @default(cuid())
  gymId      String
  type       AlertType
  memberId   String?
  title      String // i18n key
  params     Json?
  readAt     DateTime? @db.Timestamptz
  /// when the owner was told on WhatsApp; null = still waiting to be sent
  notifiedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  gym    Gym     @relation(fields: [gymId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])

  @@index([gymId, readAt, createdAt])
  @@index([gymId, notifiedAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  gymId      String
  actorType  String // "staff" | "system" | "member" | "kiosk" | "webhook"
  actorId    String?
  action     String // "payment.void", "member.left", "settings.update", "export.members", ...
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, entityType, entityId])
  @@index([gymId, createdAt])
}

model OutboxEvent {
  id           String       @id @default(cuid())
  gymId        String
  type         String // "whatsapp.receipt", "kiosk.enroll", "alert.owner", ...
  payload      Json
  dedupeKey    String       @unique
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?
  availableAt  DateTime     @default(now()) @db.Timestamptz
  createdAt    DateTime     @default(now()) @db.Timestamptz
  dispatchedAt DateTime?    @db.Timestamptz

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([status, availableAt])
}

// ───────────────────────────── Worker operations ─────────────────────────────

/// One row per worker instance; health endpoint checks lastBeatAt < 3 min
model WorkerHeartbeat {
  id         String   @id // e.g. "worker-main"
  version    String
  lastBeatAt DateTime @db.Timestamptz
  startedAt  DateTime @db.Timestamptz
}

/// Records each scheduled run (reminder slots, nightly jobs) for catch-up and auditing
model JobRun {
  id           String    @id @default(cuid())
  gymId        String?
  jobName      String // "reminder-slot", "nightly-call-tasks", ...
  /// business date + slot, e.g. "2026-09-10@19:00"; unique per job to prevent double runs
  runKey       String
  status       String // "RUNNING" | "DONE" | "FAILED"
  itemsPlanned Int       @default(0)
  itemsSent    Int       @default(0)
  itemsSkipped Int       @default(0)
  itemsFailed  Int       @default(0)
  error        String?
  startedAt    DateTime  @default(now()) @db.Timestamptz
  finishedAt   DateTime? @db.Timestamptz

  @@unique([jobName, runKey])
}
