{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./.turbo/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "seed/**/*.ts",
    "scripts/**/*.ts",
