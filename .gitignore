# pnpm storeDir (ADR-019) resolves to a repo-relative `E:` directory on non-Windows runners
/E:/
# Playwright MCP snapshots, console logs and screenshots
.playwright-mcp/

# MediaPipe WASM runtime, copied from node_modules on dev/build (apps/web/scripts/copy-mediapipe-wasm.mjs)
apps/web/public/mediapipe/wasm/

# Generated E2E camera fixtures (apps/web/scripts/make-face-fixture.mjs)
apps/web/e2e/fixtures/

# vercel cli
.vercel/
